    "allow": [
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "Bash",
      "Task",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Skill",
      "mcp__figma",
      "mcp__Figma",
      "mcp__Claude_Browser",
      "mcp__Claude_Code_iOS_Simulator",
      "mcp__visualize",
