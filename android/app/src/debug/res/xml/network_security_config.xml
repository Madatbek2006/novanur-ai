<?xml version="1.0" encoding="utf-8"?>
<!--
  Только для debug-сборок. Android 9+ (API 28) режет открытый HTTP,
  а локальный бэкенд ходит по http и живёт на адресе, который выдаёт DHCP
  и который периодически меняется. Привязка к конкретному IP тут только
  создавала бы второе место, где его надо править, поэтому в debug
  разрешаем cleartext целиком.

  Release-сборки этот файл не получают: и он, и ссылка на него в манифесте
  лежат в src/debug/, так что в проде остаётся штатный запрет.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
